# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=placement_app
DB_PASSWORD=replace_me
DB_NAME=smart_placement
DB_POOL_SIZE=10

# Authentication
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Upload limits (resume PDFs)
MAX_RESUME_MB=5

# Optional AI roadmap provider (OpenAI-compatible). Leave blank to use the
# built-in rule-based engine, which is the default and requires no API key.
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# Optional in-app notification behavior (no email/SMS provider is configured)
DEADLINE_REMINDER_DAYS=7
